rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ 여기에 선생님 로그인 이메일을 넣으세요 (여러 명이면 쉼표로 추가)
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email in ['teacher@example.com'];
    }

    // 학생 스탬프: '반+번호+PIN'으로 만든 문서 ID를 정확히 아는 경우에만 조회(get) 가능
    // 목록 조회(list)와 쓰기는 교사만 → 학생은 다른 친구 기록을 볼 수 없음
    match /students/{id} {
      allow get: if true;
      allow list, write: if isTeacher();
    }

    // PIN 목록: 교사만
    match /pins/{id} {
      allow read, write: if isTeacher();
    }

    // 스탬프 항목 설정: 누구나 읽기, 교사만 수정
    match /config/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
  }
}
